---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Gear from '../components/Gear.astro';
import { profile, skills, journey } from '../data/profile';
---

<Base title="About" description={profile.bio}>
  <PageHeader label="About" title="Engineer by degree. Builder by heart." />

  <section class="wrap intro">
    <figure class="portrait" data-reveal>
      <img src="/avatar.webp" alt={`Portrait of ${profile.name}`} width="440" height="440" />
      <div class="portrait-gear"><Gear teeth={16} size={240} hole={false} /></div>
    </figure>
    <div class="bio">
      <p class="lead" data-reveal>{profile.bio}</p>
      {profile.about.map((p) => <p data-reveal>{p}</p>)}
      <p data-reveal>
        Today I'm building <a href="https://getaix.com" target="_blank" rel="noopener">Getaix</a>, the largest
        marketplace for App Inventor extensions, and working on{' '}
        <a href="https://www.casagbic.com" target="_blank" rel="noopener">Casagbic</a>, a no-code Android app builder.
      </p>
      <dl class="facts" data-reveal>
        <div><dt class="label">Based in</dt><dd>{profile.location}</dd></div>
        <div><dt class="label">Focus</dt><dd>React · Node.js · No-code</dd></div>
        <div><dt class="label">Status</dt><dd>{profile.available ? 'Open to work' : 'Busy'}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section wrap">
    <p class="label">Journey</p>
    <h2 class="section-title" data-split>How I got here</h2>
    <div class="timeline" data-timeline>
      <span class="timeline-line" data-timeline-line aria-hidden="true"></span>
      <ol>
      {
        journey.map((j) => (
          <li class="t-item" data-timeline-item data-reveal>
            <span class="node" aria-hidden="true" />
            <span class="t-year">{j.year}</span>
            <div>
              <h3>{j.title}</h3>
              <p>{j.text}</p>
            </div>
          </li>
        ))
      }
      </ol>
    </div>
  </section>

  <section class="section wrap">
    <p class="label">Toolbox</p>
    <h2 class="section-title" data-split>Skills & tools</h2>
    <div class="skills">
      {
        Object.entries(skills).map(([group, items]) => (
          <div class="skill-group" data-reveal>
            <h3 class="label">{group}</h3>
            <ul>
              {items.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    gap: clamp(2rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
    overflow-x: clip;
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }

  .portrait {
    margin: 0;
    position: relative;
    max-width: 420px;
  }

  .portrait img {
    width: 100%;
    border-radius: calc(var(--radius) * 2);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(1.05) contrast(1.05);
  }

  .portrait-gear {
    position: absolute;
    width: 45%;
    right: -12%;
    bottom: -10%;
    color: var(--accent);
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
  }

  .bio .lead {
    color: var(--ink);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  .bio a {
    color: var(--ink);
    border-bottom: 1px solid var(--accent);
  }

  .bio a:hover {
    color: var(--accent);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin: 1rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .facts dd {
    margin: 0.25rem 0 0;
    color: var(--ink);
    font-weight: 600;
  }

  /* Timeline */
  .timeline {
    position: relative;
    padding-left: 2rem;
  }

  .timeline ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline::before,
  .timeline-line {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--line);
  }

  .timeline-line {
    background: var(--accent);
    transform-origin: top;
  }

  .t-item {
    position: relative;
    display: grid;
    gap: 0.5rem 2rem;
    padding-bottom: 3rem;
  }

  @media (min-width: 720px) {
    .t-item {
      grid-template-columns: 7rem 1fr;
    }
  }

  .node {
    position: absolute;
    left: calc(-2rem + 0.45rem - 7px);
    top: 0.35rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .t-year {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .t-item h3 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: 0.5rem;
  }

  .t-item p {
    color: var(--muted);
    max-width: 40rem;
  }

  /* Skills */
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .skill-group {
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-2);
  }

  .skill-group ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 1.15rem;
    font-weight: 600;
  }
</style>
