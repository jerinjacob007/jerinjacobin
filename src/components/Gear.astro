---
// A procedurally drawn gear. Rotation is driven by scroll in animations.ts.
interface Props {
  teeth?: number;
  size?: number;
  class?: string;
  hole?: boolean;
}

const { teeth = 18, size = 400, class: className, hole = true } = Astro.props;
const c = size / 2;
const outer = size * 0.48;
const inner = size * 0.4;
const step = (Math.PI * 2) / teeth;
const pts: string[] = [];

for (let i = 0; i < teeth; i++) {
  const a = i * step;
  // Each tooth is a trapezoid: base on the inner circle, narrower tip outside.
  const corners: [number, number][] = [
    [inner, a],
    [outer, a + step * 0.12],
    [outer, a + step * 0.38],
    [inner, a + step * 0.5],
  ];
  for (const [r, ang] of corners) {
    pts.push(`${(c + r * Math.cos(ang)).toFixed(2)},${(c + r * Math.sin(ang)).toFixed(2)}`);
  }
}
const d = `M${pts.join('L')}Z`;
const spokes = Array.from({ length: 6 }, (_, i) => (i * 360) / 6);
---

<svg class:list={['gear', className]} viewBox={`0 0 ${size} ${size}`} aria-hidden="true" data-gear>
  <path d={d} fill="none" stroke="currentColor" stroke-width="1.5"></path>
  <circle cx={c} cy={c} r={inner * 0.78} fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="4 6"></circle>
  {
    spokes.map((deg) => (
      <line
        x1={c}
        y1={c}
        x2={c + inner * 0.78 * Math.cos((deg * Math.PI) / 180)}
        y2={c + inner * 0.78 * Math.sin((deg * Math.PI) / 180)}
        stroke="currentColor"
        stroke-width="1"
      />
    ))
  }
  {hole && <circle cx={c} cy={c} r={size * 0.08} fill="none" stroke="currentColor" stroke-width="1.5" />}
</svg>
