---
import { url } from '../utils/url';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = profile.bio } = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/avatar.jpg'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="theme-color" content="#0f0d0b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Mark JS as available so animated elements start hidden; if the
         animation script hasn't taken over within 3s, show everything. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(() => {
        if (!document.documentElement.classList.contains('anim-ready')) {
          document.documentElement.classList.remove('js');
        }
      }, 3000);
    </script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <div class="cursor" aria-hidden="true" transition:persist="cursor">
      <div class="cursor-ring"><span class="cursor-shape"></span><span class="cursor-label"></span></div>
      <div class="cursor-dot"></div>
    </div>

    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 1rem;
    left: 1rem;
    width: auto;
    height: auto;
    clip: auto;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 8px;
  }

  /* Custom cursor (driven by src/scripts/animations.ts). Hidden until the
     first real mouse movement, so touch devices never see it. */
  .cursor {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
  }

  .cursor-dot,
  .cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    will-change: transform;
  }

  .cursor-dot {
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--accent);
    transition: opacity 0.2s;
  }

  .cursor-shape,
  .cursor-label {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%);
  }

  .cursor-shape {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1.5px solid rgba(243, 236, 225, 0.55);
    transition:
      width 0.4s var(--ease),
      height 0.4s var(--ease),
      background-color 0.4s var(--ease),
      border-color 0.4s var(--ease),
      scale 0.2s var(--ease);
  }

  .cursor-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--bg);
    opacity: 0;
    transition: opacity 0.25s;
  }

  /* Over links and buttons: a larger, tinted ring. */
  .cursor.is-hover .cursor-shape {
    width: 64px;
    height: 64px;
    background: rgba(255, 122, 26, 0.14);
    border-color: var(--accent);
  }

  /* Over cards: a solid disc with a label ("View", "Read"...). */
  .cursor.is-label .cursor-shape {
    width: 92px;
    height: 92px;
    background: var(--accent);
    border-color: var(--accent);
  }

  .cursor.is-label .cursor-label {
    opacity: 1;
  }

  .cursor.is-label .cursor-dot {
    opacity: 0;
  }

  .cursor.is-down .cursor-shape {
    scale: 0.8;
  }

  /* Replace the system arrow once the custom cursor is active. */
  :global(html.has-cursor),
  :global(html.has-cursor *) {
    cursor: none !important;
  }
</style>
